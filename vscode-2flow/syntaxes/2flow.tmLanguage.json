{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "2flow",
  "scopeName": "source.2flow",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#operators" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.2flow", "match": "#.*$" },
        { "name": "comment.line.double-slash.2flow", "match": "//.*$" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.2flow",
      "begin": "\\\"",
      "end": "\\\"",
      "patterns": [{ "name": "constant.character.escape.2flow", "match": "\\\\\\\\." }]
    },
    "declarations": {
      "patterns": [
        { "name": "keyword.control.flow.2flow", "match": "\\b(flow|execution)\\b" },
        { "name": "keyword.control.2flow", "match": "\\b(if|else|when|then|parallel|join|retry|timeout|compensate|fallback|human|gate)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.causal.2flow", "match": "(:)(-)(-)(:)", "captures": {
          "1": { "name": "keyword.operator.causal.edge.1.2flow" },
          "2": { "name": "keyword.operator.causal.edge.2.2flow" },
          "3": { "name": "keyword.operator.causal.edge.3.2flow" },
          "4": { "name": "keyword.operator.causal.edge.4.2flow" }
        } },
        { "name": "keyword.operator.failure.2flow", "match": "(!)(-)(>)", "captures": {
          "1": { "name": "keyword.operator.failure.mark.2flow" },
          "2": { "name": "keyword.operator.failure.arrow.1.2flow" },
          "3": { "name": "keyword.operator.failure.arrow.2.2flow" }
        } },
        { "name": "keyword.operator.invoke.2flow", "match": "(-)(>)(>)", "captures": {
          "1": { "name": "keyword.operator.invoke.1.2flow" },
          "2": { "name": "keyword.operator.invoke.2.2flow" },
          "3": { "name": "keyword.operator.invoke.3.2flow" }
        } },
        { "name": "keyword.operator.ingress.2flow", "match": "(-)(>)", "captures": {
          "1": { "name": "keyword.operator.ingress.1.2flow" },
          "2": { "name": "keyword.operator.ingress.2.2flow" }
        } },
        { "name": "keyword.operator.egress.2flow", "match": "(<)(-)", "captures": {
          "1": { "name": "keyword.operator.egress.1.2flow" },
          "2": { "name": "keyword.operator.egress.2.2flow" }
        } },
        { "name": "keyword.operator.receive.2flow", "match": "(<)(<)(-)", "captures": {
          "1": { "name": "keyword.operator.receive.1.2flow" },
          "2": { "name": "keyword.operator.receive.2.2flow" },
          "3": { "name": "keyword.operator.receive.3.2flow" }
        } },
        { "name": "keyword.operator.gate.2flow", "match": "(\\[)(\\?)([^]\\n]*)(\\])", "captures": {
          "1": { "name": "keyword.operator.gate.bracket.open.2flow" },
          "2": { "name": "keyword.operator.gate.question.2flow" },
          "3": { "name": "keyword.operator.gate.content.2flow" },
          "4": { "name": "keyword.operator.gate.bracket.close.2flow" }
        } },
        { "name": "keyword.operator.collection.2flow", "match": "(\\[)([^]\\n]*)(\\])", "captures": {
          "1": { "name": "keyword.operator.collection.bracket.open.2flow" },
          "2": { "name": "keyword.operator.collection.content.2flow" },
          "3": { "name": "keyword.operator.collection.bracket.close.2flow" }
        } }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.result.2flow", "match": "\\b(Ok|Error)\\b(?=\\s*<)" },
        { "name": "entity.name.type.2flow", "match": "(?<=<)[A-Za-z_][A-Za-z0-9_.:-]*(?=>)" },
        { "name": "storage.type.2flow", "match": "\\b(bool|u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|string|void)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.2flow", "match": "\\b(true|false|null|none)\\b" },
        { "name": "constant.numeric.2flow", "match": "\\b\\d+(?:\\.\\d+)?\\b" }
      ]
    },
    "identifiers": {
      "patterns": [
        { "name": "entity.name.function.2flow", "match": "\\b[A-Za-z_][A-Za-z0-9_-]*(?=\\s*(?:!->|:--:|$))" },
        { "name": "entity.name.namespace.2flow", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+\\b" }
      ]
    }
  }
}