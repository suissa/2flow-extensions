{
  "scopeName": "source.2flow.injection",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "name": "meta.embedded.block.2flow",
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*2flow\\b[^\\n]*$",
      "beginCaptures": { "3": { "name": "punctuation.definition.fence.markdown" } },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "endCaptures": { "0": { "name": "punctuation.definition.fence.markdown" } },
      "contentName": "meta.embedded.2flow",
      "patterns": [{ "include": "source.2flow" }]
    }
  ]
}
